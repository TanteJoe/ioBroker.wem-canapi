{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "attach",
            "name": "Attach to remote",
            "address": "127.0.0.1",
            "port": 9229,
            "outFiles": []
        },
        {
      "type": "node",
      "request": "attach",
      "name": "attach to ioBroker-Adapter",
      "address": "127.0.0.1",
      "port": 9229,
      "smartStep": true,
      "skipFiles": [
        "<node_internals>/**"
      ],
      "outFiles": []
    },
    {
  "type": "node",
  "request": "launch",
  "name": "Launch iobroker.wem_canapi",
  "program": "${workspaceFolder}/.dev-server/default/node_modules/iobroker.wem_canapi/main.js",
  "cwd": "${workspaceFolder}/.dev-server/default",
  "runtimeArgs": [
    "--preserve-symlinks",
    "--preserve-symlinks-main",
    "--inspect"
  ],
  "skipFiles": [
    "<node_internals>/**",
    "${workspaceFolder}/node_modules/**"
  ]
}
    ]
}