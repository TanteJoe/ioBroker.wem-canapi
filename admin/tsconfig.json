{
    "compilerOptions": {
        "target":           "ES2020",
        "lib":              ["ES2020", "DOM"],
        "module":           "ESNext",
        "moduleResolution": "bundler",
        "jsx":              "react-jsx",
        "strict":           false,
        "esModuleInterop":  true,
        "skipLibCheck":     true,
        "noEmit":           true,
        "allowJs":          true
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules", "build"]
}